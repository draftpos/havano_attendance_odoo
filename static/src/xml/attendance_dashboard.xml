<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="havano_attendance_odoo.AttendanceDashboard">
        <div class="o_attendance_dashboard container-fluid py-4 h-100 overflow-auto bg-view">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0 text-800">Attendance Dashboard</h1>
                <div class="d-flex">
                    <input type="date" class="form-control" t-model="state.date" t-on-change="onDateChange"/>
                </div>
            </div>

            <div class="row" t-if="state.stats">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Employees</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.total_employees"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-users fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Active Today</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.active_today"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-check-circle fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-danger shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Absent Today</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.absent_today"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-times-circle fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Early Check-in</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.early_check_in"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-sign-in fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Late Check-in</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.late_check_in"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-clock-o fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Early Check-out</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.early_check_out"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-sign-out fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-danger shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Late Check-out</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800" t-esc="state.stats.late_check_out"/>
                                </div>
                                <div class="col-auto">
                                    <i class="fa fa-clock-o fa-2x text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" t-if="state.stats">
                <!-- Pie Chart -->
                <div class="col-xl-4 col-lg-5 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Attendance Status</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-pie pt-4 pb-2" style="height: 300px; position: relative;">
                                <canvas id="attendancePieChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Bar Chart -->
                <div class="col-xl-8 col-lg-7 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Check-ins Last 7 Days</h6>
                        </div>
                        <div class="card-body">
                            <div class="chart-bar" style="height: 300px; position: relative;">
                                <canvas id="attendanceBarChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" t-if="state.stats">
                <!-- Late Check-ins Table -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-danger">Late Check-ins Today</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Time</th>
                                            <th>Delay (mins)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.stats.late_check_ins" t-as="late" t-key="late.employee_name">
                                            <td t-esc="late.employee_name"/>
                                            <td t-esc="late.check_in"/>
                                            <td><span class="badge rounded-pill text-bg-danger" t-esc="late.delay_mins + ' mins'"/></td>
                                        </tr>
                                        <tr t-if="!state.stats.late_check_ins.length">
                                            <td colspan="3" class="text-center text-muted">No late check-ins today</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity Table -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow h-100">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Recent Activity</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>Employee</th>
                                            <th>Check-in</th>
                                            <th>Check-out</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.stats.recent_activity" t-as="activity" t-key="activity.employee_name + activity.check_in">
                                            <td t-esc="activity.employee_name"/>
                                            <td t-esc="activity.check_in"/>
                                            <td t-esc="activity.check_out"/>
                                        </tr>
                                        <tr t-if="!state.stats.recent_activity.length">
                                            <td colspan="3" class="text-center text-muted">No recent activity</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
